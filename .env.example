# Application
NODE_ENV=development
PORT=3000
CORS_ORIGIN=http://localhost:3000

# Database (MySQL)
DB_HOST=localhost
DB_PORT=3306
DB_USERNAME=root
DB_PASSWORD=your_password
DB_NAME=saloon_queue

# JWT
JWT_SECRET=super_secret_key_change_in_prod
JWT_EXPIRES_IN=7d
JWT_REFRESH_SECRET=super_refresh_secret_change_in_prod
JWT_REFRESH_EXPIRES_IN=30d

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_TTL=3600

# Logging
LOG_LEVEL=info
